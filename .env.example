# Copy to .env (never commit it, never send it to anyone).
# HL_API_PRIVATE_KEY: an API WALLET key from app.hyperliquid.xyz -> More -> API.
#   It can trade but cannot withdraw. Never put your main wallet's private key here.
# HL_ACCOUNT_ADDRESS: your MAIN account address (the one holding the USDC),
#   not the API wallet's address.
HL_API_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
